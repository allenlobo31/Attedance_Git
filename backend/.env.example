PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nexus_attendance
CLIENT_ORIGIN=http://localhost:5173

# Set to true if the server sits behind a reverse proxy / load balancer (Render, Nginx, etc.)
# so the real client IP is read from X-Forwarded-For.
TRUST_PROXY=false

# ---- Location lock ----
ENFORCE_LOCATION_LOCK=true
VENUE_LAT=12.9716
VENUE_LNG=77.5946
ALLOWED_RADIUS_METERS=100
# Reject readings whose reported accuracy is worse than this (meters)
MAX_ACCURACY_METERS=100

# Timezone used to decide what counts as "today" (one entry per USN per day)
TIMEZONE=Asia/Kolkata

# Secret header value for admin API access. Generate a unique value before deploying.
ADMIN_KEY=replace-with-a-long-random-secret
